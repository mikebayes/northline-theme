{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "46rem",
			"wideSize": "78rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"customDuotone": false,
			"link": true,
			"palette": [
				{ "slug": "base",      "color": "#ffffff", "name": "Base" },
				{ "slug": "surface",   "color": "#f2f6f9", "name": "Surface" },
				{ "slug": "line",      "color": "#dbe3ec", "name": "Hairline" },
				{ "slug": "steel",     "color": "#5b6e81", "name": "Steel" },
				{ "slug": "slate",     "color": "#16283a", "name": "Slate" },
				{ "slug": "ink",       "color": "#0b1622", "name": "Ink" },
				{ "slug": "primary",   "color": "#f2a01d", "name": "Voltage" },
				{ "slug": "primary-deep", "color": "#c67c07", "name": "Voltage Deep" },
				{ "slug": "accent",    "color": "#2bb3a3", "name": "Aurora" }
			],
			"gradients": [
				{
					"slug": "midnight",
					"name": "Midnight",
					"gradient": "linear-gradient(160deg, #0b1622 0%, #16283a 60%, #1d3a52 100%)"
				},
				{
					"slug": "voltage",
					"name": "Voltage",
					"gradient": "linear-gradient(135deg, #f2a01d 0%, #f7bd57 100%)"
				},
				{
					"slug": "surface-fade",
					"name": "Surface Fade",
					"gradient": "linear-gradient(180deg, #ffffff 0%, #f2f6f9 100%)"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"lineHeight": true,
			"dropCap": false,
			"writingMode": false,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Sans",
					"fontFamily": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", \"Noto Sans\", Arial, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "X Small",
					"size": "0.8125rem"
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.9375rem"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.0625rem",
					"fluid": { "min": "1rem", "max": "1.125rem" }
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.375rem",
					"fluid": { "min": "1.1875rem", "max": "1.5rem" }
				},
				{
					"slug": "x-large",
					"name": "X Large",
					"size": "2rem",
					"fluid": { "min": "1.625rem", "max": "2.25rem" }
				},
				{
					"slug": "xx-large",
					"name": "XX Large",
					"size": "2.75rem",
					"fluid": { "min": "2.125rem", "max": "3.25rem" }
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "3.75rem",
					"fluid": { "min": "2.625rem", "max": "4.5rem" }
				}
			]
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true,
			"units": [ "px", "em", "rem", "%", "vw", "vh" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "1 — XS",   "size": "clamp(0.5rem, 1vw, 0.75rem)" },
				{ "slug": "30", "name": "2 — S",    "size": "clamp(0.875rem, 1.6vw, 1.25rem)" },
				{ "slug": "40", "name": "3 — M",    "size": "clamp(1.25rem, 2.4vw, 2rem)" },
				{ "slug": "50", "name": "4 — L",    "size": "clamp(2rem, 4vw, 3rem)" },
				{ "slug": "60", "name": "5 — XL",   "size": "clamp(3rem, 6vw, 4.5rem)" },
				{ "slug": "70", "name": "6 — 2XL",  "size": "clamp(4rem, 8vw, 6.5rem)" },
				{ "slug": "80", "name": "7 — 3XL",  "size": "clamp(5rem, 11vw, 9rem)" }
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "soft",  "name": "Soft",  "shadow": "0 1px 2px rgba(11, 22, 34, 0.04), 0 8px 24px -12px rgba(11, 22, 34, 0.18)" },
				{ "slug": "lift",  "name": "Lift",  "shadow": "0 2px 4px rgba(11, 22, 34, 0.05), 0 18px 40px -18px rgba(11, 22, 34, 0.30)" }
			]
		},
		"blocks": {
			"core/button": {
				"border": { "radius": true }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--slate)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65",
			"letterSpacing": "-0.003em"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary-deep)" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--ink)" }
				}
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.12",
					"letterSpacing": "-0.02em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "letterSpacing": "-0.01em" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "letterSpacing": "0" } },
			"h5": { "typography": { "fontSize": "var(--wp--preset--font-size--small)", "letterSpacing": "0" } },
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"letterSpacing": "0.14em",
					"textTransform": "uppercase",
					"fontWeight": "700"
				},
				"color": { "text": "var(--wp--preset--color--steel)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--ink)"
				},
				"border": { "radius": "3px" },
				"spacing": {
					"padding": {
						"top": "0.9em",
						"bottom": "0.9em",
						"left": "1.6em",
						"right": "1.6em"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "700",
					"letterSpacing": "0.02em",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-deep)",
						"text": "var(--wp--preset--color--base)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--primary-deep)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--steel)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--x-small)" }
			}
		},
		"blocks": {
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--line)" }
			},
			"core/quote": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "1.45"
				}
			},
			"core/pullquote": {
				"typography": { "fontSize": "var(--wp--preset--font-size--large)" }
			},
			"core/code": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--mono)" },
				"color": { "background": "var(--wp--preset--color--surface)" }
			},
			"core/list": {
				"spacing": { "padding": { "left": "1.15em" } }
			},
			"core/table": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" }
			}
		}
	}
}
